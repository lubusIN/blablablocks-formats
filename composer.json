{
    "name": "lubusin/blablablocks-formats",
    "description": "A collection of rich text formats for the WordPress block editor.",
    "keywords": [
        "wordpress",
        "plugin",
        "block",
        "formats",
        "blablablocks"
    ],
    "homepage": "https://lubus.in",
    "license": "MIT",
    "authors": [
        {
            "name": "Punit Verma",
            "email": "punit@lubus.in",
            "homepage": "https://lubus.in"
        },
        {
            "name": "Ajit Bohra",
            "email": "ajit@lubus.in",
            "homepage": "https://lubus.in"
        }
    ],
    "type": "wordpress-plugin",
    "support": {
        "issues": "https://github.com/lubusIN/blablablocks-formats/issues",
        "source": "https://github.com/lubusIN/blablablocks-formats"
    },
    "extra": {
        "installer-name": "blablablocks-formats"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --debug --memory-limit=512M",
        "test:php": "phpunit"
    },
    "require": {
        "php": ">=7.4",
        "composer/installers": "^2.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpunit/phpunit": "^11.5",
        "brain/monkey": "^2.7"
    }
}
